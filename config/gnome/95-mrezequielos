# MrEzequielOS - padrões do desktop estilo Zorin (layout Windows)
# Instalado em /etc/dconf/db/gdm.d/ pelo apply-theme.sh. Rode `dconf update` depois.
[org/gnome/desktop/interface]
gtk-theme='ZorinPurple-Dark'
icon-theme='ZorinPurple-Dark'
cursor-theme='Yaru'
color-scheme='prefer-dark'
accent-color='purple'
font-name='Inter 11'
document-font-name='Inter 11'
monospace-font-name='Ubuntu Mono 13'
enable-animations=true

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/mrezequielos-wallpaper.svg'
picture-uri-dark='file:///usr/share/backgrounds/mrezequielos-wallpaper.svg'
picture-options='zoom'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/mrezequielos-wallpaper.svg'
lock-enabled=true

[org/gnome/desktop/wm/preferences]
theme='ZorinPurple-Dark'
button-layout='close,minimize,maximize:'

[org/gnome/shell]
favorite-apps=['brave-browser.desktop', 'org.gnome.Nautilus.desktop', 'libreoffice-writer.desktop', 'org.gnome.Terminal.desktop', 'org.gnome.Software.desktop']
enabled-extensions=['zorin-taskbar@zorinos.com', 'arcmenu@arcmenu.com', 'blur-my-shell@aunetx', 'ding@rastersoft.com', 'appindicatorsupport@rgcjonas.gmail.com', 'zorin-connect@zorinos.com', 'user-theme@gnome-shell-extensions.gcampax.github.com']
disable-user-extensions=false

[org/gnome/shell/extensions/zorin-taskbar]
panel-positions='{"0": "BOTTOM"}'
panel-sizes='{"0": 48}'
panel-element-positions='{"0": [{"element": "showAppsButton", "visible": false, "position": "stackedTL"}, {"element": "activitiesButton", "visible": false, "position": "stackedTL"}, {"element": "leftBox", "visible": true, "position": "stackedTL"}, {"element": "taskbar", "visible": true, "position": "centerMonitor"}, {"element": "centerBox", "visible": true, "position": "stackedBR"}, {"element": "rightBox", "visible": true, "position": "stackedBR"}, {"element": "dateMenu", "visible": true, "position": "stackedBR"}, {"element": "systemMenu", "visible": true, "position": "stackedBR"}, {"element": "desktopButton", "visible": false, "position": "stackedBR"}]}'
global-border-radius=12
trans-use-custom-opacity=true
trans-panel-opacity=0.75
isolate-workspaces=true
isolate-monitors=true
group-apps=true
show-favorites=true
show-running-apps=true

[org/gnome/shell/extensions/arcmenu]
menu-layout='arcmenu'
menu-button-appearance='Icon'
menu-button-icon='/usr/share/pixmaps/mrezequielos-start.svg'
menu-button-icon-size=28
menu-button-border-radius=(true, 22)
show-activities-button=false
default-menu-view='Categories_List'
menu-button-right-click-action='None'
context-menu-items=[{'id': 'ArcMenu_PowerOptions', 'name': 'Power Options', 'icon': 'system-shutdown-symbolic'}, {'id': 'ArcMenu_Separator', 'name': 'Separator', 'icon': 'list-remove-symbolic'}, {'id': 'ArcMenu_ShowDesktop', 'name': 'Show Desktop', 'icon': 'computer-symbolic'}, {'id': 'ArcMenu_ActivitiesOverview', 'name': 'Activities Overview', 'icon': 'view-fullscreen-symbolic'}]
pinned-apps=[[{'id': 'brave-browser.desktop'}], [{'id': 'org.gnome.Nautilus.desktop'}], [{'id': 'org.gnome.Terminal.desktop'}], [{'id': 'org.gnome.Software.desktop'}], [{'id': 'libreoffice-writer.desktop'}], [{'id': 'mrezequielos-help.desktop'}]]

[org/gnome/shell/extensions/ding]
show-home=true
show-trash=true
show-volumes=true

[org/gnome/shell/extensions/blur-my-shell/panel]
blur=true
brightness=0.6
sigma=30

[org/gnome/desktop/peripherals/touchpad]
tap-to-click=true

[org/freedesktop/tracker/miner/files]
crawling-interval=-2
enable-monitors=false
