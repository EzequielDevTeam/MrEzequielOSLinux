#!/bin/bash
# MrEzequielOS Appearance - central de visual (igual Zorin Appearance).
# Layout, Tema, Cor de destaque, Fundo, Interface e Efeitos.
# Uso: mrezequielos-appearance [windows|mac|ubuntu|efeitos|tema|cor|fundo|interface]
MODE="${1:-}"

ok() {
  if zenity --question --title="MrEzequielOS Appearance" --text="Aplicado: <b>$1</b>." --ok-label="Reiniciar agora" --cancel-label="Depois" 2>/dev/null; then
    systemctl reboot 2>/dev/null || sudo reboot 2>/dev/null || true
  fi
  echo "Aplicado: $1."
}

pick_icon() {
  if [ -d /usr/share/icons/ZorinPurple-Dark ]; then echo "ZorinPurple-Dark";
  elif [ -d /usr/share/icons/Tela-purple-dark ]; then echo "Tela-purple-dark";
  elif [ -d /usr/share/icons/Tela-dark ]; then echo "Tela-dark";
  else echo "Papirus-Dark"; fi
}

pick_gtk() {
  if [ -d /usr/share/themes/ZorinPurple-Dark ]; then echo "ZorinPurple-Dark";
  elif [ -d /usr/share/themes/Yaru-purple-dark ]; then echo "Yaru-purple-dark";
  else echo "Yaru-dark"; fi
}

apply_windows() {
  GTK=$(pick_gtk)
  gsettings set org.gnome.desktop.interface gtk-theme "$GTK" || true
  gsettings set org.gnome.desktop.wm.preferences theme "$GTK" || true
  gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' || true
  gsettings set org.gnome.desktop.interface accent-color 'purple' || true
  gsettings set org.gnome.desktop.interface cursor-theme 'Yaru' || true
  gsettings set org.gnome.desktop.interface icon-theme "$(pick_icon)" || true
  if gsettings set org.gnome.desktop.interface font-name 'Inter 11' 2>/dev/null; then :; else gsettings set org.gnome.desktop.interface font-name 'Ubuntu 11' || true; fi
  gsettings set org.gnome.desktop.background picture-uri 'file:///usr/share/backgrounds/mrezequielos-wallpaper.svg' || true
  gsettings set org.gnome.desktop.background picture-uri-dark 'file:///usr/share/backgrounds/mrezequielos-wallpaper.svg' || true
  gsettings set org.gnome.shell favorite-apps "['brave-browser.desktop', 'org.gnome.Nautilus.desktop', 'libreoffice-writer.desktop', 'org.gnome.Terminal.desktop', 'org.gnome.Software.desktop']" || true
  gsettings set org.gnome.shell enabled-extensions "['zorin-taskbar@zorinos.com', 'arcmenu@arcmenu.com', 'blur-my-shell@aunetx', 'ding@rastersoft.com', 'appindicatorsupport@rgcjonas.gmail.com', 'zorin-connect@zorinos.com', 'user-theme@gnome-shell-extensions.gcampax.github.com']" || true
  gsettings set org.gnome.shell disable-user-extensions false || true
  dconf write /org/gnome/shell/extensions/zorin-taskbar/panel-positions "'{\"0\":\"BOTTOM\"}'" || true
  dconf write /org/gnome/shell/extensions/zorin-taskbar/panel-sizes "'{\"0\":48}'" || true
  dconf write /org/gnome/shell/extensions/zorin-taskbar/panel-element-positions "'{\"0\":[{\"element\":\"showAppsButton\",\"visible\":false,\"position\":\"stackedTL\"},{\"element\":\"activitiesButton\",\"visible\":false,\"position\":\"stackedTL\"},{\"element\":\"leftBox\",\"visible\":true,\"position\":\"stackedTL\"},{\"element\":\"taskbar\",\"visible\":true,\"position\":\"centerMonitor\"},{\"element\":\"centerBox\",\"visible\":true,\"position\":\"stackedBR\"},{\"element\":\"rightBox\",\"visible\":true,\"position\":\"stackedBR\"},{\"element\":\"dateMenu\",\"visible\":true,\"position\":\"stackedBR\"},{\"element\":\"systemMenu\",\"visible\":true,\"position\":\"stackedBR\"},{\"element\":\"desktopButton\",\"visible\":false,\"position\":\"stackedBR\"}]}'" || true
  dconf write /org/gnome/shell/extensions/zorin-taskbar/global-border-radius 3 || true
  dconf write /org/gnome/shell/extensions/zorin-taskbar/highlight-appicon-hover-border-radius 12 || true
  dconf write /org/gnome/shell/extensions/zorin-taskbar/trans-use-custom-opacity true || true
  dconf write /org/gnome/shell/extensions/zorin-taskbar/trans-panel-opacity 0.75 || true
  dconf write /org/gnome/shell/extensions/zorin-taskbar/isolate-workspaces true || true
  dconf write /org/gnome/shell/extensions/arcmenu/menu-layout "'arcmenu'" || true
  dconf write /org/gnome/shell/extensions/arcmenu/menu-button-appearance "'Icon'" || true
  dconf write /org/gnome/shell/extensions/arcmenu/menu-button-icon "'/usr/share/pixmaps/mrezequielos-start.svg'" || true
  dconf write /org/gnome/shell/extensions/arcmenu/menu-button-icon-size 28 || true
  dconf write /org/gnome/shell/extensions/arcmenu/show-activities-button false || true
  dconf write /org/gnome/shell/extensions/arcmenu/menu-arrow-rise "(true, 0)" || true
  dconf write /org/gnome/shell/extensions/arcmenu/default-menu-view "'Categories_List'" || true
  dconf write /org/gnome/shell/extensions/arcmenu/menu-button-right-click-action "'None'" || true
  dconf write /org/gnome/shell/extensions/arcmenu/context-menu-items "'[{\"id\": \"ArcMenu_PowerOptions\", \"name\": \"Power Options\", \"icon\": \"system-shutdown-symbolic\"}, {\"id\": \"ArcMenu_Separator\", \"name\": \"Separator\", \"icon\": \"list-remove-symbolic\"}, {\"id\": \"ArcMenu_ShowDesktop\", \"name\": \"Show Desktop\", \"icon\": \"computer-symbolic\"}, {\"id\": \"ArcMenu_ActivitiesOverview\", \"name\": \"Activities Overview\", \"icon\": \"view-fullscreen-symbolic\"}]'" || true
  gsettings set org.gnome.shell.extensions.ding show-home true || true
  gsettings set org.gnome.shell.extensions.ding show-trash true || true
}

apply_mac() {
  GTK=$(pick_gtk)
  gsettings set org.gnome.desktop.interface gtk-theme "$GTK" || true
  gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' || true
  gsettings set org.gnome.desktop.interface accent-color 'purple' || true
  gsettings set org.gnome.desktop.interface icon-theme "$(pick_icon)" || true
  gsettings set org.gnome.desktop.background picture-uri 'file:///usr/share/backgrounds/mrezequielos-wallpaper.svg' || true
  gsettings set org.gnome.desktop.background picture-uri-dark 'file:///usr/share/backgrounds/mrezequielos-wallpaper.svg' || true
  gsettings set org.gnome.shell enabled-extensions "['ding@rastersoft.com', 'blur-my-shell@aunetx', 'appindicatorsupport@rgcjonas.gmail.com', 'user-theme@gnome-shell-extensions.gcampax.github.com', 'dash-to-dock@micxgx.gmail.com']" || true
  dconf write /org/gnome/shell/extensions/dash-to-dock/dock-position "'BOTTOM'" || true
  dconf write /org/gnome/shell/extensions/dash-to-dock/extend-height false || true
  dconf write /org/gnome/shell/extensions/arcmenu/menu-button-appearance "'Icon'" || true
  dconf write /org/gnome/shell/extensions/arcmenu/menu-button-icon "'/usr/share/pixmaps/mrezequielos-start.svg'" || true
  dconf write /org/gnome/shell/extensions/arcmenu/menu-button-icon-size 28 || true
}

apply_ubuntu() {
  gsettings set org.gnome.desktop.interface gtk-theme 'Yaru' || true
  gsettings set org.gnome.desktop.interface color-scheme 'default' || true
  gsettings set org.gnome.desktop.interface icon-theme 'Papirus' || true
  gsettings set org.gnome.shell enabled-extensions "['ding@rastersoft.com', 'appindicatorsupport@rgcjonas.gmail.com', 'ubuntu-dock@ubuntu.com']" || true
  gsettings set org.gnome.shell favorite-apps "['brave-browser.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Terminal.desktop', 'org.gnome.Software.desktop']" || true
  dconf write /org/gnome/shell/extensions/arcmenu/menu-button-appearance "'Icon'" || true
  dconf write /org/gnome/shell/extensions/arcmenu/menu-button-icon "'/usr/share/pixmaps/mrezequielos-start.svg'" || true
  dconf write /org/gnome/shell/extensions/arcmenu/menu-button-icon-size 28 || true
}

pin_apps() {
  dconf write /org/gnome/shell/extensions/arcmenu/pinned-apps "'[[{\"id\": \"brave-browser.desktop\"}, {\"id\": \"org.gnome.Nautilus.desktop\"}], [{\"id\": \"org.gnome.Terminal.desktop\"}], [{\"id\": \"gnome-control-center.desktop\"}], [{\"id\": \"org.gnome.Software.desktop\"}], [{\"id\": \"libreoffice-writer.desktop\"}], [{\"id\": \"org.gnome.Calculator.desktop\"}], [{\"id\": \"mrezequielos-help.desktop\"}]]'" || true
}

pick_layout() {
  zenity --list --title="MrEzequielOS Appearance - Layout" \
    --text="Escolha o layout do desktop:" \
    --column="Layout" --column="Descrição" \
    windows "Barra única embaixo + menu iniciar (padrão)" \
    mac "Barra em cima + dock embaixo (macOS)" \
    ubuntu "Barra lateral (Ubuntu)" 2>/dev/null || echo "windows"
}

tema() {
  T=$(zenity --list --title="MrEzequielOS Appearance - Tema" \
    --text="Escolha o tema:" --column="Tema" --column="Descrição" \
    roxo "Escuro roxo MrEzequielOS (padrão)" \
    escuro "Escuro padrão" \
    claro "Claro padrão" 2>/dev/null || echo "")
  case "$T" in
    claro) gsettings set org.gnome.desktop.interface gtk-theme 'Yaru' || true
      gsettings set org.gnome.desktop.wm.preferences theme 'Yaru' || true
      gsettings set org.gnome.desktop.interface color-scheme 'default' || true ;;
    escuro) gsettings set org.gnome.desktop.interface gtk-theme 'Yaru-dark' || true
      gsettings set org.gnome.desktop.wm.preferences theme 'Yaru-dark' || true
      gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' || true ;;
    roxo) G=$(pick_gtk)
      gsettings set org.gnome.desktop.interface gtk-theme "$G" || true
      gsettings set org.gnome.desktop.wm.preferences theme "$G" || true
      gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' || true ;;
    *) return 0 ;;
  esac
  ok "tema"
}

cor() {
  C=$(zenity --list --title="MrEzequielOS Appearance - Cor de destaque" \
    --text="Cor dos botões, interruptores e detalhes:" --column="Cor" --column="" \
    roxo "Roxo MrEzequielOS (padrão)" \
    laranja "Laranja Ubuntu" \
    azul "Azul" \
    verde "Verde" \
    vermelho "Vermelho" 2>/dev/null || echo "")
  case "$C" in
    laranja) A=orange ;; azul) A=blue ;; verde) A=green ;; vermelho) A=red ;; roxo) A=purple ;;
    *) return 0 ;;
  esac
  gsettings set org.gnome.desktop.interface accent-color "$A" || true
  ok "cor de destaque"
}

fundo() {
  MAP=$(find /usr/share/backgrounds -maxdepth 2 \( -name '*.jpg' -o -name '*.png' -o -name '*.svg' \) 2>/dev/null | sort | head -20)
  [ -z "$MAP" ] && return 0
  LIST=""
  while IFS= read -r f; do
    base=$(basename "$f")
    if [ "$f" = "/usr/share/backgrounds/mrezequielos-wallpaper.svg" ]; then
      LIST="$LIST mrezequielos \"MrEzequielOS (padrão)\""
    else
      LIST="$LIST \"$base\" \"$f\""
    fi
  done <<EOF
$MAP
EOF
  # shellcheck disable=SC2086
  ESC=$(eval zenity --list --title="MrEzequielOS Appearance - Fundo" --text="Escolha o papel de parede:" --column="ID" --column="Arquivo" $LIST 2>/dev/null) || return 0
  [ -z "$ESC" ] && return 0
  if [ "$ESC" = "mrezequielos" ]; then F="/usr/share/backgrounds/mrezequielos-wallpaper.svg";
  else F=$(echo "$MAP" | grep -F "/$ESC" | head -1); fi
  [ -z "$F" ] && return 0
  gsettings set org.gnome.desktop.background picture-uri "file://$F" || true
  gsettings set org.gnome.desktop.background picture-uri-dark "file://$F" || true
  ok "fundo"
}

interface() {
  CUR=$(gsettings get org.gnome.desktop.interface enable-animations 2>/dev/null || echo true)
  if [ "$CUR" = "true" ]; then ST="FALSE"; TXT="Animações estão LIGADAS. Desligar (mais rápido)?";
  else ST="TRUE"; TXT="Animações estão DESLIGADAS. Ligar (mais bonito)?"; fi
  if zenity --question --title="MrEzequielOS Appearance - Interface" --text="$TXT" 2>/dev/null; then
    if [ "$ST" = "TRUE" ]; then gsettings set org.gnome.desktop.interface enable-animations true || true
    else gsettings set org.gnome.desktop.interface enable-animations false || true; fi
    ok "interface"
  fi
}

effects() {
  CUR=$(gsettings get org.gnome.shell enabled-extensions 2>/dev/null || echo "[]")
  st() { echo "$CUR" | grep -q "$1" && echo TRUE || echo FALSE; }
  SEL=$(zenity --list --checklist --title="MrEzequielOS Appearance - Efeitos" \
    --text="Marque os efeitos (o resto essencial fica sempre ligado):" \
    --column="" --column="Efeito" --column="Descrição" \
    $(st blur-my-shell) "blur" "Desfoque no painel e janelas" \
    $(st ding) "icones" "Ícones na área de trabalho" \
    $(st burn-my-windows) "fogo" "Janelas com efeito fogo/energia" \
    $(st desktop-cube) "cubo" "Cubo 3D ao trocar área de trabalho" \
    --separator=" " --width=560 --height=300 2>/dev/null) || exit 0
  NEW=$(python3 - "$SEL" <<'PYEOF'
import ast, sys, subprocess
cur = ast.literal_eval(subprocess.check_output(
  ['gsettings', 'get', 'org.gnome.shell', 'enabled-extensions']).decode())
want = {'blur': 'blur-my-shell@aunetx', 'icones': 'ding@rastersoft.com',
        'fogo': 'burn-my-windows@schneegans.github.com', 'cubo': 'desktop-cube@schneegans.github.com'}
sel = sys.argv[1].split() if len(sys.argv) > 1 else []
out = [u for u in cur if u not in want.values()] + [want[k] for k in sel if k in want]
print(str(out))
PYEOF
)
  [ -n "$NEW" ] && gsettings set org.gnome.shell enabled-extensions "$NEW" || true
  ok "efeitos"
}

if [ -z "$MODE" ]; then
  ACAO=$(zenity --list --title="MrEzequielOS Appearance" \
    --text="O que ajustar?" --column="Ação" --column="Descrição" \
    layout "Estilo Windows, macOS ou Ubuntu" \
    tema "Claro, escuro ou roxo" \
    cor "Cor de destaque dos botões" \
    fundo "Papel de parede" \
    interface "Animações ligado/desligado" \
    efeitos "Efeitos visuais e ícones do desktop" 2>/dev/null) || exit 0
  case "$ACAO" in
    tema) tema; exit 0 ;;
    cor) cor; exit 0 ;;
    fundo) fundo; exit 0 ;;
    interface) interface; exit 0 ;;
    efeitos) effects; exit 0 ;;
  esac
  MODE=$(pick_layout)
fi

case "$MODE" in
  efeitos) effects ;;
  tema) tema ;;
  cor) cor ;;
  fundo) fundo ;;
  interface) interface ;;
  mac*) apply_mac; pin_apps; ok "macOS" ;;
  ubuntu*) apply_ubuntu; pin_apps; ok "Ubuntu" ;;
  *) apply_windows; pin_apps; ok "Windows" ;;
esac
