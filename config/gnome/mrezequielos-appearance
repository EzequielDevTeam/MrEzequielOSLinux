#!/bin/bash
# MrEzequielOS Appearance - central de visual (layouts + efeitos).
# Uso: mrezequielos-appearance [windows|mac|ubuntu|efeitos]
MODE="${1:-}"

ok() { zenity --info --title="MrEzequielOS Appearance" --text="Aplicado: <b>$1</b>.\nSaia e entre de novo (ou Alt+F2 → r no Xorg) para recarregar." 2>/dev/null || echo "Aplicado: $1."; }

pick_icon() {
  if [ -d /usr/share/icons/Tela-purple-dark ]; then echo "Tela-purple-dark";
  elif [ -d /usr/share/icons/Tela-dark ]; then echo "Tela-dark";
  else echo "Papirus-Dark"; fi
}

apply_windows() {
  gsettings set org.gnome.desktop.interface gtk-theme 'Yaru-dark' || true
  gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' || true
  gsettings set org.gnome.desktop.interface accent-color 'purple' || true
  gsettings set org.gnome.desktop.interface cursor-theme 'Yaru' || true
  gsettings set org.gnome.desktop.interface icon-theme "$(pick_icon)" || true
  if gsettings set org.gnome.desktop.interface font-name 'Inter 11' 2>/dev/null; then :; else gsettings set org.gnome.desktop.interface font-name 'Ubuntu 11' || true; fi
  gsettings set org.gnome.desktop.background picture-uri 'file:///usr/share/backgrounds/mrezequielos-wallpaper.svg' || true
  gsettings set org.gnome.desktop.background picture-uri-dark 'file:///usr/share/backgrounds/mrezequielos-wallpaper.svg' || true
  gsettings set org.gnome.shell favorite-apps "['brave-browser.desktop', 'org.gnome.Nautilus.desktop', 'libreoffice-writer.desktop', 'org.gnome.Terminal.desktop', 'org.gnome.Software.desktop']" || true
  gsettings set org.gnome.shell enabled-extensions "['dash-to-panel@jderose9.github.com', 'arcmenu@arcmenu.com', 'blur-my-shell@aunetx', 'ding@rastersoft.com', 'appindicatorsupport@rgcjonas.gmail.com', 'user-theme@gnome-shell-extensions.gcampax.github.com']" || true
  gsettings set org.gnome.shell disable-user-extensions false || true
  dconf write /org/gnome/shell/extensions/dash-to-panel/panel-positions "'{\"0\":\"BOTTOM\"}'" || true
  dconf write /org/gnome/shell/extensions/dash-to-panel/panel-sizes "'{\"0\":48}'" || true
  dconf write /org/gnome/shell/extensions/dash-to-panel/panel-element-positions "'{\"0\":[{\"element\":\"showAppsButton\",\"visible\":false,\"position\":\"stackedTL\"},{\"element\":\"activitiesButton\",\"visible\":false,\"position\":\"stackedTL\"},{\"element\":\"leftBox\",\"visible\":true,\"position\":\"stackedTL\"},{\"element\":\"taskbar\",\"visible\":true,\"position\":\"centerMonitor\"},{\"element\":\"centerBox\",\"visible\":true,\"position\":\"stackedBR\"},{\"element\":\"rightBox\",\"visible\":true,\"position\":\"stackedBR\"},{\"element\":\"dateMenu\",\"visible\":true,\"position\":\"stackedBR\"},{\"element\":\"systemMenu\",\"visible\":true,\"position\":\"stackedBR\"},{\"element\":\"desktopButton\",\"visible\":true,\"position\":\"stackedBR\"}]}'" || true
  dconf write /org/gnome/shell/extensions/dash-to-panel/global-border-radius 12 || true
  dconf write /org/gnome/shell/extensions/dash-to-panel/trans-use-custom-opacity true || true
  dconf write /org/gnome/shell/extensions/dash-to-panel/trans-panel-opacity 0.75 || true
  dconf write /org/gnome/shell/extensions/dash-to-panel/isolate-workspaces true || true
  dconf write /org/gnome/shell/extensions/arcmenu/menu-layout "'arcmenu'" || true
  dconf write /org/gnome/shell/extensions/arcmenu/menu-button-appearance "'Icon'" || true
  dconf write /org/gnome/shell/extensions/arcmenu/menu-button-icon "'/usr/share/pixmaps/mrezequielos-start.svg'" || true
  dconf write /org/gnome/shell/extensions/arcmenu/menu-button-icon-size 28 || true
  dconf write /org/gnome/shell/extensions/arcmenu/show-activities-button false || true
  gsettings set org.gnome.shell.extensions.ding show-home true || true
  gsettings set org.gnome.shell.extensions.ding show-trash true || true
}

apply_mac() {
  gsettings set org.gnome.desktop.interface gtk-theme 'Yaru-dark' || true
  gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' || true
  gsettings set org.gnome.desktop.interface accent-color 'purple' || true
  gsettings set org.gnome.desktop.interface icon-theme "$(pick_icon)" || true
  gsettings set org.gnome.desktop.background picture-uri 'file:///usr/share/backgrounds/mrezequielos-wallpaper.svg' || true
  gsettings set org.gnome.desktop.background picture-uri-dark 'file:///usr/share/backgrounds/mrezequielos-wallpaper.svg' || true
  gsettings set org.gnome.shell enabled-extensions "['ding@rastersoft.com', 'blur-my-shell@aunetx', 'appindicatorsupport@rgcjonas.gmail.com', 'user-theme@gnome-shell-extensions.gcampax.github.com', 'dash-to-dock@micxgx.gmail.com']" || true
  dconf write /org/gnome/shell/extensions/dash-to-dock/dock-position "'BOTTOM'" || true
  dconf write /org/gnome/shell/extensions/dash-to-dock/extend-height false || true
  dconf write /org/gnome/shell/extensions/arcmenu/menu-button-appearance "'Icon'" || true
  dconf write /org/gnome/shell/extensions/arcmenu/menu-button-icon "'/usr/share/pixmaps/mrezequielos-start.svg'" || true
  dconf write /org/gnome/shell/extensions/arcmenu/menu-button-icon-size 28 || true
}

apply_ubuntu() {
  gsettings set org.gnome.desktop.interface gtk-theme 'Yaru' || true
  gsettings set org.gnome.desktop.interface color-scheme 'default' || true
  gsettings set org.gnome.desktop.interface icon-theme 'Papirus' || true
  gsettings set org.gnome.shell enabled-extensions "['ding@rastersoft.com', 'appindicatorsupport@rgcjonas.gmail.com', 'ubuntu-dock@ubuntu.com']" || true
  gsettings set org.gnome.shell favorite-apps "['brave-browser.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Terminal.desktop', 'org.gnome.Software.desktop']" || true
  dconf write /org/gnome/shell/extensions/arcmenu/menu-button-appearance "'Icon'" || true
  dconf write /org/gnome/shell/extensions/arcmenu/menu-button-icon "'/usr/share/pixmaps/mrezequielos-start.svg'" || true
  dconf write /org/gnome/shell/extensions/arcmenu/menu-button-icon-size 28 || true
}

pin_apps() {
  dconf write /org/gnome/shell/extensions/arcmenu/pinned-apps "'[[{\"id\": \"brave-browser.desktop\"}, {\"id\": \"org.gnome.Nautilus.desktop\"}], [{\"id\": \"org.gnome.Terminal.desktop\"}], [{\"id\": \"org.gnome.Software.desktop\"}], [{\"id\": \"libreoffice-writer.desktop\"}], [{\"id\": \"mrezequielos-help.desktop\"}]]'" || true
}

effects() {
  CUR=$(gsettings get org.gnome.shell enabled-extensions 2>/dev/null || echo "[]")
  st() { echo "$CUR" | grep -q "$1" && echo TRUE || echo FALSE; }
  SEL=$(zenity --list --checklist --title="MrEzequielOS Appearance - Efeitos" \
    --text="Marque os efeitos (o resto essencial fica sempre ligado):" \
    --column="" --column="Efeito" --column="Descrição" \
    $(st blur-my-shell) "blur" "Desfoque no painel e janelas" \
    $(st ding) "icones" "Ícones na área de trabalho" \
    $(st burn-my-windows) "fogo" "Janelas com efeito fogo/energia" \
    $(st desktop-cube) "cubo" "Cubo 3D ao trocar área de trabalho" \
    --separator=" " --width=560 --height=300 2>/dev/null) || exit 0
  NEW=$(python3 - "$SEL" <<'PYEOF'
import ast, sys
cur = ast.literal_eval(__import__('subprocess').check_output(
  ['gsettings', 'get', 'org.gnome.shell', 'enabled-extensions']).decode())
want = {'blur': 'blur-my-shell@aunetx', 'icones': 'ding@rastersoft.com',
        'fogo': 'burn-my-windows@schneegans.github.com', 'cubo': 'desktop-cube@schneegans.github.com'}
sel = sys.argv[1].split() if len(sys.argv) > 1 else []
out = [u for u in cur if u not in want.values()] + [want[k] for k in sel if k in want]
print(str(out))
PYEOF
)
  [ -n "$NEW" ] && gsettings set org.gnome.shell enabled-extensions "$NEW" || true
  ok "efeitos"
}

if [ -z "$MODE" ]; then
  ACAO=$(zenity --list --title="MrEzequielOS Appearance" \
    --text="O que ajustar?" --column="Ação" --column="Descrição" \
    layout "Estilo Windows, macOS ou Ubuntu" \
    efeitos "Efeitos visuais e ícones do desktop" 2>/dev/null) || exit 0
  if [ "$ACAO" = "efeitos" ]; then effects; exit 0; fi
  MODE=$(zenity --list --title="MrEzequielOS Appearance" \
    --text="Escolha o layout do desktop (igual Zorin OS):" \
    --column="Layout" --column="Descrição" \
    windows "Barra única embaixo + menu iniciar (padrão)" \
    mac "Barra em cima + dock embaixo (macOS)" \
    ubuntu "Barra lateral (Ubuntu)" 2>/dev/null || echo "windows")
fi

case "$MODE" in
  efeitos) effects ;;
  mac*) apply_mac; pin_apps; ok "macOS" ;;
  ubuntu*) apply_ubuntu; pin_apps; ok "Ubuntu" ;;
  *) apply_windows; pin_apps; ok "Windows" ;;
esac
