[Plymouth Theme]
Name=MrEzequielOS
Description=Tela de carregamento do MrEzequielOS
ModuleName=two-step

[two-step]
Font=Ubuntu 11
TitleFont=Ubuntu Light 28
ImageDir=/usr/share/plymouth/themes/mrezequielos
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.382
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.25
HorizontalAlignment=.5
VerticalAlignment=.62
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.42
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x1a0533
BackgroundEndColor=0xe95420
ProgressBarBackgroundColor=0xffffff
ProgressBarForegroundColor=0xffffff
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false
