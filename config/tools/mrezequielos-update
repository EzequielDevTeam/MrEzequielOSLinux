# MrEzequielOS Update - atualizador próprio com JANELA (igual Zorin, sem terminal).
# A interface roda como usuário; só o motor usa root (uma senha só).
# Uso: mrezequielos-update [--check|--notify]
REPO="EzequielDevTeam/MrEzequielOSLinux"
VER_FILE="/etc/mrezequielos-version"
FLAG="/var/lib/mrezequielos/update-available"
CUR=$(cat "$VER_FILE" 2>/dev/null || echo "1.1")
API="https://api.github.com/repos/$REPO"

latest_tag() {
  curl -s --max-time 25 "$API/releases/latest" 2>/dev/null | python3 -c "import json,sys; print(json.load(sys.stdin).get('tag_name',''))" 2>/dev/null || echo ""
}
is_newer() { [ -n "$1" ] && [ "$1" != "$CUR" ] && [ "$(printf '%s\n%s' "$CUR" "$1" | sort -V | tail -1)" = "$1" ]; }

list_releases() {
  curl -s --max-time 25 "$API/releases?per_page=20" 2>/dev/null | python3 -c "
import json, sys
try:
    rels = json.load(sys.stdin)
except Exception:
    sys.exit(1)
for r in rels:
    if r.get('draft') or r.get('prerelease'):
        continue
    tag = (r.get('tag_name') or '').lstrip('v')
    name = (r.get('name') or tag).replace('|', '-')
    date = (r.get('published_at') or '')[:10]
    print('%s|%s|%s' % (tag, name, date))
" 2>/dev/null || echo ""
}

priv_script() {
  local TAG="$1" OUT="$2"
  cat > "$OUT" <<EOF
#!/bin/bash
export DEBIAN_FRONTEND=noninteractive
LOG=/var/log/mrezequielos-update.log
exec > >(tee -a "\$LOG") 2>&1
REPO="$REPO"
TAG="$TAG"
VER_FILE="$VER_FILE"
if grep -q "boot=casper" /proc/cmdline 2>/dev/null || grep -q " casper" /proc/cmdline 2>/dev/null; then
  echo "FALHA-LIVE: no modo live use o Instalador, nao o atualizador."
  exit 1
fi
TMPD=\$(mktemp -d)
echo "# Baixando MrEzequielOS \$TAG..."
# TODO: verificar assinatura/checksum do tarball (hoje confia no HTTPS do GitHub).
curl -sL --retry 2 --max-time 180 -o "\$TMPD/sys.tar.gz" "https://github.com/\$REPO/archive/refs/tags/v\$TAG.tar.gz" || { echo "FALHA-DOWNLOAD"; rm -rf "\$TMPD"; exit 1; }
echo "# Abrindo pacote..."
tar xzf "\$TMPD/sys.tar.gz" -C "\$TMPD" || { echo "FALHA-TAR"; rm -rf "\$TMPD"; exit 1; }
TOP=\$(find "\$TMPD" -maxdepth 1 -type d -name "MrEzequielOSLinux-*" | head -1)
[ -z "\$TOP" ] && { echo "FALHA-LAYOUT"; rm -rf "\$TMPD"; exit 1; }
NEWBASE=\$(grep -E "^UBUNTU_CODENAME=" "\$TOP/config/branding/os-release" 2>/dev/null | cut -d= -f2)
CURBASE=\$(grep -E "^UBUNTU_CODENAME=" /etc/os-release 2>/dev/null | cut -d= -f2)
if [ -n "\$NEWBASE" ] && [ -n "\$CURBASE" ] && [ "\$NEWBASE" != "\$CURBASE" ]; then
  echo "FALHA-BASE: pacote da base \$NEWBASE, sistema na base \$CURBASE. Versao grande exige instalacao limpa."
  rm -rf "\$TMPD"; exit 1
fi
LIB="\$TOP/config/tools/mre-apply-lib.sh"
[ -f "\$LIB" ] || { echo "FALHA-LIB"; rm -rf "\$TMPD"; exit 1; }
. "\$LIB"
echo "# Pre-voo (disco)..."
[ \$(df --output=avail /tmp | tail -1) -gt 400000 ] || { echo "FALHA-DISCO-TMP"; rm -rf "\$TMPD"; exit 1; }
[ \$(df --output=avail / | tail -1) -gt 1500000 ] || { echo "FALHA-DISCO-ROOT"; rm -rf "\$TMPD"; exit 1; }
BACKUP=/var/lib/mrezequielos/backup-\$(cat "\$VER_FILE" 2>/dev/null || echo "?")
echo "# Backup em \$BACKUP..."
mkdir -p "\$BACKUP"
cp /etc/dconf/db/local.d/95-mrezequielos "\$BACKUP/95-local" 2>/dev/null || true
cp /etc/dconf/db/gdm.d/95-mrezequielos "\$BACKUP/95-gdm" 2>/dev/null || true
mre_backup_users "\$BACKUP"
echo "# Aplicando interface e ferramentas..."
chmod +x "\$TOP/config/gnome/"* "\$TOP/config/tools/"* 2>/dev/null || true
cp "\$TOP/config/tools/mrezequielos-update" /usr/local/bin/mrezequielos-update
cp "\$TOP/config/tools/mrezequielos-security" /usr/local/bin/mrezequielos-security
chmod +x /usr/local/bin/mrezequielos-update /usr/local/bin/mrezequielos-security
cp "\$TOP/config/tools/"*.desktop /usr/share/applications/ 2>/dev/null || true
cp "\$TOP/config/tools/mrezequielos-update-notify.desktop" /etc/xdg/autostart/ 2>/dev/null || true
cp "\$TOP/config/gnome/mrezequielos-appearance" /usr/local/bin/mrezequielos-appearance
chmod +x /usr/local/bin/mrezequielos-appearance
cp "\$TOP/config/tools/mrezequielos-appearance-gtk.py" /usr/local/bin/mrezequielos-appearance-gtk
cp "\$TOP/config/tools/mrezequielos-try-install" /usr/local/bin/mrezequielos-try-install 2>/dev/null || true
cp "\$TOP/config/tools/mrezequielos-live-keyring" /usr/local/bin/mrezequielos-live-keyring 2>/dev/null || true
cp "\$TOP/config/tools/mrezequielos-diagnostico" /usr/local/bin/mrezequielos-diagnostico 2>/dev/null || true
chmod +x /usr/local/bin/mrezequielos-appearance-gtk /usr/local/bin/mrezequielos-try-install /usr/local/bin/mrezequielos-live-keyring /usr/local/bin/mrezequielos-diagnostico 2>/dev/null || true
rm -f /usr/local/bin/mrezequielos-test-installer /usr/share/applications/mrezequielos-test-installer.desktop 2>/dev/null || true
chmod 644 /usr/share/applications/mrezequielos-*.desktop /etc/xdg/autostart/mrezequielos-*.desktop 2>/dev/null || true
mkdir -p /usr/share/help/C/mrezequielos-help
cp "\$TOP/config/help/C/mrezequielos-help/"*.page /usr/share/help/C/mrezequielos-help/ 2>/dev/null || true
cp "\$TOP/config/tools/mrezequielos-welcome" /usr/local/bin/mrezequielos-welcome 2>/dev/null || true
cp "\$TOP/config/tools/mrezequielos-welcome.desktop" /etc/xdg/autostart/ 2>/dev/null || true
chmod +x /usr/local/bin/mrezequielos-welcome 2>/dev/null || true
for d in /usr/share/applications/yelp.desktop; do
  if [ -f "\$d" ] && ! grep -q "^NoDisplay=true" "\$d"; then
    echo "NoDisplay=true" >> "\$d"
  fi
done
cp "\$TOP/config/branding/wallpaper.svg" /usr/share/backgrounds/mrezequielos-wallpaper.svg 2>/dev/null || true
cp "\$TOP/config/branding/logo.svg" /usr/share/pixmaps/mrezequielos.svg 2>/dev/null || true
cp "\$TOP/config/branding/logo.svg" /usr/share/pixmaps/mrezequielos-logo.svg 2>/dev/null || true
cp "\$TOP/config/branding/start-button.svg" /usr/share/pixmaps/mrezequielos-start.svg 2>/dev/null || true
for l in windows mac ubuntu; do
  cp "\$TOP/config/branding/layout-\$l.svg" "/usr/share/pixmaps/mrezequielos-layout-\$l.svg" 2>/dev/null || true
done
cp "\$TOP/config/branding/os-release" /etc/os-release 2>/dev/null || true
mkdir -p /usr/share/doc/mrezequielos
cp "\$TOP/LICENSE" /usr/share/doc/mrezequielos/LICENSE 2>/dev/null || true
cp "\$TOP/TRADEMARK.md" /usr/share/doc/mrezequielos/TRADEMARK.md 2>/dev/null || true
mkdir -p /etc/dconf/db/local.d /etc/dconf/db/gdm.d
cp "\$TOP/config/gnome/95-mrezequielos" /etc/dconf/db/local.d/95-mrezequielos
cp "\$TOP/config/gnome/95-mrezequielos" /etc/dconf/db/gdm.d/95-mrezequielos
dconf update || true
echo "# Tema de boot nosso + boot direto (sem entradas fantasmas)..."
mkdir -p /usr/share/plymouth/themes/mrezequielos
cp "\$TOP/config/plymouth/mrezequielos/mrezequielos.plymouth" /usr/share/plymouth/themes/mrezequielos/ 2>/dev/null || true
cp "\$TOP/config/branding/plymouth-watermark.png" /usr/share/plymouth/themes/mrezequielos/watermark.png 2>/dev/null || true
SPIN="/usr/share/plymouth/themes/spinner"
if [ -d "\$SPIN" ]; then
  cp "\$SPIN"/animation-*.png "\$SPIN"/throbber-*.png /usr/share/plymouth/themes/mrezequielos/ 2>/dev/null || true
  cp "\$SPIN"/entry.png "\$SPIN"/lock.png "\$SPIN"/bullet.png "\$SPIN"/keyboard.png "\$SPIN"/keymap-render.png "\$SPIN"/capslock.png /usr/share/plymouth/themes/mrezequielos/ 2>/dev/null || true
fi
update-alternatives --install /usr/share/plymouth/themes/default.plymouth default.plymouth /usr/share/plymouth/themes/mrezequielos/mrezequielos.plymouth 100 2>/dev/null || true
update-alternatives --set default.plymouth /usr/share/plymouth/themes/mrezequielos/mrezequielos.plymouth 2>/dev/null || true
update-initramfs -u -k all 2>/dev/null || echo "# AVISO initramfs"
if ! grep -q "^GRUB_DISABLE_OS_PROBER=true" /etc/default/grub 2>/dev/null; then
  echo 'GRUB_DISABLE_OS_PROBER=true' >> /etc/default/grub
fi
sed -i 's/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=2/' /etc/default/grub 2>/dev/null || true
if grep -q "^GRUB_TIMEOUT_STYLE=" /etc/default/grub 2>/dev/null; then
  sed -i 's/^GRUB_TIMEOUT_STYLE=.*/GRUB_TIMEOUT_STYLE=hidden/' /etc/default/grub
else
  echo 'GRUB_TIMEOUT_STYLE=hidden' >> /etc/default/grub
fi
update-grub 2>/dev/null || echo "# AVISO grub"
echo "# Instalando extensoes novas..."
"\$TOP/config/gnome/install-extensions.sh" || true
echo "# Instalando temas Zorin..."
"\$TOP/config/gnome/install-zorin-themes.sh" || true
echo "# gdk-pixbuf 2.42 sem glycin (igual Zorin)..."
chmod +x "\$TOP/config/gnome/install-pixbuf-242.sh" 2>/dev/null || true
"\$TOP/config/gnome/install-pixbuf-242.sh" || echo "# AVISO pixbuf 2.42 falhou"
echo "# Icone nosso no atualizador..."
for t in ZorinPurple-Dark ZorinGrey-Dark Zorin Yaru-dark Papirus-Dark; do
  if [ -d "/usr/share/icons/\$t" ]; then
    mkdir -p "/usr/share/icons/\$t/scalable/apps"
    cp "\$TOP/config/branding/logo.svg" "/usr/share/icons/\$t/scalable/apps/system-software-update.svg" 2>/dev/null || true
    cp "\$TOP/config/branding/logo.svg" "/usr/share/icons/\$t/scalable/apps/software-update-available.svg" 2>/dev/null || true
  fi
done
gtk-update-icon-cache -f /usr/share/icons/ZorinPurple-Dark 2>/dev/null || true
gtk-update-icon-cache -f /usr/share/icons/Papirus-Dark 2>/dev/null || true
echo "# Patches de branding (update-manager + ubiquity)..."
"\$TOP/config/tools/mrezequielos-branding-patches.sh" || echo "# AVISO patches falharam"
echo "# Visual do Ubiquity (logo, welcome, slideshow)..."
"\$TOP/config/tools/mrezequielos-ubiquity-visual.sh" || echo "# AVISO ubiquity visual falhou"
echo "# Verificando o novo..."
THEME_OK=1
for d in /usr/share/themes/ZorinPurple-Dark /usr/share/icons/ZorinPurple-Dark; do
  if [ -d "\$d" ]; then echo "# tema OK: \$d"; else echo "# tema FALTA: \$d"; THEME_OK=0; fi
done
if mre_verify_required "\$TOP/config/required-extensions.txt" && [ "\$THEME_OK" = "1" ]; then
  echo "# Limpando modulos obsoletos..."
  mre_purge_obsolete "\$TOP/config/obsolete-extensions.txt"
  echo "# Resetando configs velhas (usuarios logados)..."
  mre_reset_users "\$TOP/config/dconf-reset-list.txt"
else
  echo "# Novo incompleto: restaurando backup, sem regressao"
  mre_restore_users "\$BACKUP"
  cp "\$BACKUP/95-local" /etc/dconf/db/local.d/95-mrezequielos 2>/dev/null || true
  cp "\$BACKUP/95-gdm" /etc/dconf/db/gdm.d/95-mrezequielos 2>/dev/null || true
  dconf update 2>/dev/null || true
  rm -rf "\$TMPD"
  exit 1
fi
sed -i '/cdrom:/d' /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources 2>/dev/null || true
echo "# Atualizando pacotes Ubuntu (demora)..."
apt update && apt full-upgrade -y || { echo "FALHA-APT"; rm -rf "\$TMPD"; exit 1; }
echo "# Reinstalando base (auto-reparo, um por um para um nome errado nao abortar tudo)..."
while IFS= read -r pkg || [ -n "\$pkg" ]; do
  case "\$pkg" in ''|\#*) continue ;; esac
  apt install -y "\$pkg" 2>/dev/null || echo "# AVISO pacote falhou: \$pkg"
done < "\$TOP/config/core-packages.txt"
echo "# Removendo ajuda Ubuntu (fica só a nossa)..."
apt purge -y gnome-user-docs ubuntu-docs 2>/dev/null || true
for p in gnome-shell gdm3 gnome-session yelp; do dpkg -s \$p >/dev/null 2>&1 || apt install -y \$p; done
echo "\$TAG" > "\$VER_FILE"
rm -rf "\$TMPD"
echo "# Pronto!"
EOF
  chmod +x "$OUT"
}

run_priv() {
  local TAG="$1"
  local SCR
  umask 077
  SCR=$(mktemp /tmp/mre-apply-XXXXXX.sh)
  chmod 600 "$SCR"
  priv_script "$TAG" "$SCR"
  local RC=0
  if [ -n "$DISPLAY" ] || [ -n "$WAYLAND_DISPLAY" ]; then
    pkexec bash "$SCR" 2>&1 | zenity --progress --pulsate --auto-close --no-cancel \
      --title="MrEzequielOS Update" --text="Iniciando..." --width=450 2>/dev/null
    RC=${PIPESTATUS[0]}
  else
    sudo bash "$SCR"; RC=$?
  fi
  rm -f "$SCR"
  return $RC
}

gui() {
  local RELS ROWS=() TAG NAME DATE ST
  RELS=$(list_releases)
  if [ -z "$RELS" ]; then
    zenity --info --title="MrEzequielOS Update" --text="Sem internet ou sem releases.\nVersão atual: <b>$CUR</b>." 2>/dev/null
    return 0
  fi
  while IFS='|' read -r TAG NAME DATE; do
    [ -z "$TAG" ] && continue
    if [ "$TAG" = "$CUR" ]; then ST="instalada (reaplicar)"; SEL="FALSE";
    elif is_newer "$TAG"; then ST="nova!"; SEL="TRUE";
    else continue; fi
    ROWS+=("$SEL" "$TAG" "$NAME" "$DATE" "$ST")
  done <<EOFRELS
$RELS
EOFRELS
  if [ ${#ROWS[@]} -eq 0 ]; then
    zenity --info --title="MrEzequielOS Update" --text="Nada novo. Versão: <b>$CUR</b>." 2>/dev/null
    rm -f "$FLAG"
    return 0
  fi
  local PICK
  PICK=$(zenity --list --radiolist --title="MrEzequielOS Update" \
    --text="Escolha a versão (atual: <b>$CUR</b>):" \
    --column="" --column="Versão" --column="Nome" --column="Data" --column="" \
    "${ROWS[@]}" --width=620 --height=320 2>/dev/null) || return 0
  [ -z "$PICK" ] && return 0
  if ! zenity --question --title="MrEzequielOS Update" \
    --text="Aplicar a versão <b>$PICK</b>? Nada será apagado." 2>/dev/null; then
    xdg-open "https://github.com/$REPO/releases" 2>/dev/null || true
    return 0
  fi
  if run_priv "$PICK"; then
    rm -f "$FLAG"
    if zenity --question --title="MrEzequielOS Update" --text="Versão <b>$PICK</b> aplicada." --ok-label="Reiniciar agora" --cancel-label="Depois" 2>/dev/null; then
      systemctl reboot 2>/dev/null || sudo reboot 2>/dev/null || true
    fi
  else
    zenity --error --title="MrEzequielOS Update" --text="Falhou. Detalhes em /var/log/mrezequielos-update.log (ou app Diagnóstico)." 2>/dev/null
  fi
}

case "$1" in
  --do-apply)
    shift; TAG="$1"
    [ -z "$TAG" ] && { echo "FALHA: sem versao"; exit 1; }
    umask 077
    SCR=$(mktemp /tmp/mre-apply-XXXXXX.sh)
    chmod 600 "$SCR"
    priv_script "$TAG" "$SCR"
    bash "$SCR"; RC=$?
    rm -f "$SCR"
    exit $RC
    ;;
  --check)
    mkdir -p /var/lib/mrezequielos
    TAG=$(latest_tag); TAG="${TAG#v}"
    if is_newer "$TAG"; then echo "$TAG" > "$FLAG"; else rm -f "$FLAG"; fi
    exit 0
    ;;
  --notify)
    if [ -f "$FLAG" ]; then
      TAG=$(cat "$FLAG")
      notify-send "MrEzequielOS Update" "Nova versão disponível: $TAG (atual: $CUR). Abra Atualização do Sistema." -i system-software-update 2>/dev/null || true
      zenity --info --title="MrEzequielOS Update" --text="Nova versão disponível: <b>$TAG</b> (atual: $CUR).\nAbra <b>Atualização do Sistema</b>." 2>/dev/null || echo "Atualização disponível: $TAG"
    fi
    exit 0
    ;;
esac

if ! command -v zenity >/dev/null || { [ -z "$DISPLAY" ] && [ -z "$WAYLAND_DISPLAY" ]; }; then
  echo "Versão atual: $CUR (modo texto)"
  if grep -q "boot=casper" /proc/cmdline 2>/dev/null; then echo "Modo live: use o Instalador."; exit 1; fi
  sudo apt update && sudo apt full-upgrade -y
  exit $?
fi
gui
